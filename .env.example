# Copy to .env for local runs; on Streamlit Cloud put these in App settings -> Secrets.
# Never commit real keys.
# Where the dashboard reads scanner output (raw URL of the data branch):
DATA_URL=https://raw.githubusercontent.com/<your-github-user>/<your-repo>/data
# Part 3 - AI and news APIs (only GROQ_API_KEY is required)
GROQ_API_KEY=
GROQ_QUICK_MODEL=openai/gpt-oss-20b
GROQ_ANALYST_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=
EXA_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
